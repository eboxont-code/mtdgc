# Client-visible Supabase settings (publishable key only)
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=

# Server-side Supabase settings
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Optional browser error reporting
VITE_SENTRY_DSN=

# Public site origin for canonical URLs, Open Graph, JSON-LD and the sitemap.
# Set the same value for the server runtime and the browser build. Default is https://mtdgc.com.
SITE_URL=https://mtdgc.com
VITE_SITE_URL=https://mtdgc.com

# Developer-only Drizzle migration connection; never expose to the browser
LOVABLE_DB_MIGRATION_URL=
